# Copy to .env (git-ignored). Every variable is optional for local use; docker-compose.yml
# falls back to the defaults shown here. NEVER commit real keys.

# --- Postgres (local container) ---
POSTGRES_DB=medusa
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa

# --- Medusa ---
MEDUSA_PORT=9000
# shared = server + background worker in one process (local). Production splits into
# one `server` and one `worker` instance.
MEDUSA_WORKER_MODE=shared
# Run `medusa db:migrate` before every start. Set false when migrations run as a deploy step.
MEDUSA_RUN_MIGRATIONS=true
# Generate real values for any deployed instance: openssl rand -hex 32
JWT_SECRET=local-dev-jwt-secret
COOKIE_SECRET=local-dev-cookie-secret
# The admin session cookie is Secure under NODE_ENV=production; false lets it work over
# plain-HTTP localhost. Never set this on an HTTPS deployment.
MEDUSA_COOKIE_SECURE=false
# Admin dashboard -> API URL, inlined at image build time. "/" = same origin.
MEDUSA_BACKEND_URL=/

# --- CORS (comma separated). 4173 = zsite dev/preview server. ---
STORE_CORS=http://localhost:4173,http://127.0.0.1:4173
ADMIN_CORS=http://localhost:9000,http://127.0.0.1:9000
AUTH_CORS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:9000,http://127.0.0.1:9000

# --- Stripe (optional). Empty = Stripe provider not registered; only the manual
# pp_system_default provider exists. Use test keys (sk_test_...) locally.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Local admin user created by scripts/bootstrap.sh and used by scripts/smoke.sh ---
MEDUSA_ADMIN_EMAIL=admin@zagware.local
MEDUSA_ADMIN_PASSWORD=local-admin-password
